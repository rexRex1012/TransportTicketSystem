      "boundElements": null,
      "updated": 1793039237903,
      "link": null,
      "locked": false,
      "text": "1. A job goes to the sector of its pickup\n2. Shared pickup? It goes by the\n    destination's sector\n3. Both shared? It goes to Main Hospital\n\nED and Main Hospital are neighbors",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. A job goes to the sector of its pickup\n2. Shared pickup? It goes by the\n    destination's sector\n3. Both shared? It goes to Main Hospital\n\nED and Main Hospital are neighbors",
      "autoResize": true,
      "lineHeight": 1.25
