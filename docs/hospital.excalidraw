    {
      "id": "ZIxFu9LIlPtsLHdNfxgLt",
      "type": "text",
      "x": 1824,
      "y": 576,
      "width": 291.955078125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1437350511,
      "version": 2,
      "versionNonce": 1640764161,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794410066214,
      "link": null,
      "locked": false,
      "text": "1. A job goes to the sector of its pickup\n2. Shared pickup, or no pickup? It goes\n    by the destination's sector\n3. Both shared? It goes to Main Hospital\n\nEveryone works every sector. At sign-in\nyou pick First and Secondary sectors\n(Surgical is in everyone's First).\nWaiting 10+ minutes? The next free\ntransporter takes it, any sector.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. A job goes to the sector of its pickup\n2. Shared pickup, or no pickup? It goes\n    by the destination's sector\n3. Both shared? It goes to Main Hospital\n\nEveryone works every sector. At sign-in\nyou pick First and Secondary sectors\n(Surgical is in everyone's First).\nWaiting 10+ minutes? The next free\ntransporter takes it, any sector.",
      "autoResize": true,
      "lineHeight": 1.25
    },
