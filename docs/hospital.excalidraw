      "link": null,
      "locked": false,
      "text": "Endo specimen runs: Endo to Labs\n   12:00am, 2:00pm, 4:30pm\n\nO2 restock: from the O2 Room\n   12:00am and 7:00pm, next floor in rotation\n   A, 2, 3, 4, 5, 6, 7, back to A\n   ED not included, except CDU\n\nDepartments can request extra runs anytime",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Endo specimen runs: Endo to Labs\n   12:00am, 2:00pm, 4:30pm\n\nO2 restock: from the O2 Room\n   12:00am and 7:00pm, next floor in rotation\n   A, 2, 3, 4, 5, 6, 7, back to A\n   ED not included, except CDU\n\nDepartments can request extra runs anytime",
      "autoResize": true,
      "lineHeight": 1.25
